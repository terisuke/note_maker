scenario-evo-x2-llama-swap-media-matrix:
	@if [ "$${RUN_EVO_X2_LLAMA_SWAP_MEDIA_MATRIX:-0}" != "1" ]; then echo "Set RUN_EVO_X2_LLAMA_SWAP_MEDIA_MATRIX=1 to run the live Evo X2 llama-swap 5-format fallback-only matrix."; exit 2; fi
	SCENARIO_OUTPUT_DIR=tmp/media_matrix go run ./cmd/scenario/media_matrix
	RUN_LIVE_MEDIA_MATRIX=1 LIVE_MEDIA_MATRIX_CASES="terisuke_note_essay,cor_blog_technical_report,cor_blog_vision_sharing,cloudia_zenn_tutorial,cloudia_qiita_how_to,cor_homepage_section" SCENARIO_STREAM_DRAFT=1 SCENARIO_OUTPUT_DIR=tmp/media_matrix LIVE_MEDIA_MATRIX_OUTPUT_DIR=tmp/media_matrix/llama_swap LLM_BASE_URL="$(EVO_X2_LLAMA_CPP_LLM_BASE_URL)" LLM_MODEL="gemma4:31b" STYLE_LLM_MODEL="gemma4:e2b" BRIEF_LLM_MODEL="qwen3.6:27b" ARTICLE_LLM_MODEL="gemma4:e2b" DRAFT_LLM_MODEL="gemma4:31b" VERIFY_LLM_MODEL="gemma4:31b" LLM_TIMEOUT_SECONDS=900 LLM_STREAM_FIRST_BYTE_TIMEOUT_SECONDS=8 LLM_STREAM_IDLE_TIMEOUT_SECONDS="$(LLM_STREAM_IDLE_TIMEOUT_SECONDS)" LLM_FALLBACK_BASE_URLS="" STYLE_LLM_FALLBACK_MODELS="" BRIEF_LLM_FALLBACK_MODELS="" ARTICLE_LLM_FALLBACK_MODELS="" DRAFT_LLM_FALLBACK_MODELS="" VERIFY_LLM_FALLBACK_MODELS="" SCENARIO_MIN_STYLE_SCORE=82 SCENARIO_MIN_KEYWORD_OVERLAP=70 SCENARIO_MAX_FIRST_CHUNK_MS=8000 DRAFT_MAX_ATTEMPTS=2 go run ./cmd/scenario/live_media_matrix

