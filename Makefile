	@if [ "$${RUN_EVO_X2_LLAMA_SWAP_SCENARIO:-0}" != "1" ]; then echo "Set RUN_EVO_X2_LLAMA_SWAP_SCENARIO=1 to run the live Evo X2 llama-swap 3-model validation."; exit 2; fi
