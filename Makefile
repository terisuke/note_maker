server:
	go run ./cmd/server

desktop-assets:
	rsync -a --delete --exclude 'history_ui_test.go' --exclude 'vendor/' static/ cmd/desktop/frontend/
	rm -rf cmd/desktop/frontend/_vendor
	mkdir -p cmd/desktop/frontend/_vendor
	rsync -a static/vendor/ cmd/desktop/frontend/_vendor/

desktop-preview: desktop-assets
	NOTE_MAKER_DESKTOP_ADDR="$(NOTE_MAKER_DESKTOP_ADDR)" go run ./cmd/desktop

desktop-check: desktop-assets
	(cd cmd/desktop && go list -m github.com/wailsapp/wails/v2 | grep -q '$(WAILS_VERSION)$$')
	(cd cmd/desktop && go test -tags wails ./...)

desktop-dev: desktop-check
	(cd cmd/desktop && go run github.com/wailsapp/wails/v2/cmd/wails@$(WAILS_VERSION) dev)

desktop-build: desktop-check
	(cd cmd/desktop && go run github.com/wailsapp/wails/v2/cmd/wails@$(WAILS_VERSION) build)

llama:
	$(LLAMA_SERVER) \
		--hf-repo $(LLAMACPP_HF_REPO) \
		--hf-file $(LLAMACPP_HF_FILE) \
		--alias $(LLAMACPP_MODEL) \
		--host $(LLAMACPP_HOST) \
		--port $(LLAMACPP_PORT)

docker-build:
	docker build -t note-maker:dev .

docker-run: docker-build
	docker run --rm -p $(PORT):8080 note-maker:dev

docker-compose-up:
	docker compose up -d --build

docker-compose-down:
	docker compose down

check:
	go test ./...

e2e:
	python3 -m pytest tests/e2e
